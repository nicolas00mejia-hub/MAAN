---
import Icon from './Icon.astro';
import { routes, type Dict, type Locale } from '../i18n';

interface Props {
  t: Dict;
  locale: Locale;
}
const { t, locale } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="section">
  <div class="wrap">
    <header class="section__head" data-reveal>
      <p class="eyebrow">{t.pillars.eyebrow}</p>
      <h2 data-scrub>{t.pillars.title} <em>{t.pillars.titleAccent}</em></h2>
    </header>

    <ul class="pillars">
      {t.pillars.items.map((p, i) => (
        <li data-reveal style={`--d: ${i * 90}ms`}>
          <a class="pillar" href={`${routes.services[locale]}#${p.id}`}>
            <span class="pillar__num">{num(i)}</span>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <ul>
              {p.list.map((item) => <li>{item}</li>)}
            </ul>
            <span class="pillar__arrow" aria-hidden="true"><Icon name="up-right" /></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="more" data-reveal>
      <a class="btn btn--ghost" href={routes.services[locale]}>{t.pillars.more} <span aria-hidden="true"><Icon name="right" /></span></a>
    </p>
  </div>
</section>
