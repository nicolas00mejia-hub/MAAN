---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const loop = [...t.marquee, ...t.marquee];
---
<section class="hero">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{t.hero.eyebrow}</p>
    <h1 class="hero__title">
      <span class="line" data-reveal>{t.hero.line1}</span>
      <span class="line" data-reveal style="--d: 90ms">
        {t.hero.line2a} <em>{t.hero.line2b}</em>
      </span>
    </h1>

    <div class="hero__row">
      <div class="hero__copy" data-reveal style="--d: 180ms">
        <p class="lead">{t.hero.lead}</p>
        <div class="hero__cta">
          <a class="btn" href="#contacto">{t.hero.primary} <span aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="#servicios">{t.hero.secondary}</a>
        </div>
      </div>

      <dl class="hero__facts" data-reveal style="--d: 260ms">
        <div>
          <dt>{t.hero.marketsLabel}</dt>
          <dd>{t.hero.markets}</dd>
        </div>
        <div>
          <dt>{t.hero.langsLabel}</dt>
          <dd>{t.hero.langs}</dd>
        </div>
      </dl>

      <div class="badge" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <defs>
            <path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
          </defs>
          <text><textPath href="#badge-circle" textLength="486">{t.hero.badge.toUpperCase()}</textPath></text>
        </svg>
        <span class="badge__core">↘</span>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {loop.map((item) => (
        <span>
          {item}
          <i>✳</i>
        </span>
      ))}
    </div>
  </div>
</section>
