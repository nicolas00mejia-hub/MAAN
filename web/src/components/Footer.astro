---
import { site } from '../config/site';
import { routes, type Dict, type Locale, type PageKey } from '../i18n';

interface Props {
  t: Dict;
  locale: Locale;
}
const { t, locale } = Astro.props;
const links: PageKey[] = ['home', 'services', 'work', 'about', 'contact'];
const social = [
  { label: 'Instagram', href: site.instagram },
  { label: 'TikTok', href: site.tiktok },
].filter((s) => s.href);
---
<footer class="footer" data-enter>
  <div class="wrap">
    <p class="footer__mark" aria-hidden="true">MAAN studio</p>
    <div class="footer__row">
      <p>{t.footer.tagline}<br />{t.hero.markets}</p>
      <ul class="footer__nav">
        {links.map((key) => (
          <li><a href={routes[key][locale]}>{t.nav[key]}</a></li>
        ))}
      </ul>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
      <p class="footer__legal">
        © {new Date().getFullYear()} {site.name}. {t.footer.rights}<br />
        <a href="#top">{t.footer.top} ↑</a>
      </p>
    </div>
  </div>
</footer>
